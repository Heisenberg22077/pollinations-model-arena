{
  "name": "pollinations-model-arena",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "One Question, Every Model. A BYOP model comparison table built on Pollinations.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/postbuild.mjs",
    "build:pages": "tsc -b && vite build --base=/pollinations-model-arena/ && node scripts/postbuild.mjs",
    "preview": "vite preview",
    "assets:design": "node scripts/generate-design-assets.mjs",
    "typecheck": "tsc -b --pretty false",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test:e2e": "playwright test",
    "test:e2e:live": "playwright test e2e/live.spec.ts",
    "review:frontend": "node scripts/review-frontend.mjs",
    "review:motion": "node scripts/review-motion.mjs",
    "assets:reference": "node scripts/fetch-reference-art.mjs",
    "verify:artifact": "node scripts/verify-artifact.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "motion": "14.10.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
